# PolarHub API Configuration
POLARHUB_API_BASE_URL=https://polarhub-YOUR_TENANT.sandbox.halo-platform.net
POLARHUB_TENANT_ID=YOUR_TENANT_ID
POLARHUB_API_SECRET=your_base64_encoded_secret_here
POLARHUB_TIMEOUT_MS=30000
POLARHUB_RETRY_COUNT=3

# Agency Sender Configuration
POLARHUB_SITE_CODE=01
POLARHUB_AGENCY_NAME=Whitelabel Agency

# Travel Agency ContactInfo (CTC_TA1) - Required for OrderCreate
# This ContactInfo is automatically injected into sender.travelAgency.contactInfoRefId
POLARHUB_AGENCY_CONTACT_ID=CTC_TA1
POLARHUB_AGENCY_EMAIL=agency@example.com
POLARHUB_AGENCY_PHONE_COUNTRY_CODE=82
POLARHUB_AGENCY_PHONE_NUMBER=000000000
POLARHUB_AGENCY_POSTAL_STREET=Your Agency Street Address
POLARHUB_AGENCY_POSTAL_CODE=00000
POLARHUB_AGENCY_POSTAL_CITY=Your City
POLARHUB_AGENCY_POSTAL_COUNTRY=KR

# Server Configuration
# Switch NODE_ENV to production if you want to suppress file-based request logging.
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*
