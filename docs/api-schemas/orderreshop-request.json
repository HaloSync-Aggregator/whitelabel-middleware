{
  "api": "OrderReshop",
  "root_schema": "OrderReshopRQ24",
  "total_schemas": 5,
  "schemas": {
    "OrderReshopRQ24": {
      "properties": {
        "Sender": {
          "properties": {
            "TravelAgency": {
              "description": "Travel agency information",
              "$ref": "#/components/schemas/TravelAgencyType1"
            }
          },
          "required": [
            "TravelAgency"
          ],
          "type": "object"
        },
        "PointOfSale": {
          "type": "string",
          "description": "Point of sale"
        },
        "TransactionID": {
          "type": "string",
          "description": "Unique transaction ID (UUID) \nExample: 4ba5a0b50d2c45b3b5eb343b57ba8897\n\nMust be a 32-character random string.\n\nUsed for internal log tracing."
        },
        "Query": {
          "properties": {
            "OrderID": {
              "type": "string",
              "description": "Unique order identifier"
            },
            "ActionContext": {
              "type": "string",
              "description": "When processing a schedule change due to an involuntary change, include ActionContext.\n\nAccept Involuntary \nPADIS Codeset REA – Reason for action\n1 Sched change – flight number change\n2 Sched change – flight retimed\n3 Sched change – flight cancelled\n4 Sched change – permanent withdrawal of service\n5 Sched change – labor dispute\n6 Bereavement\n7 Illness\n8 Voluntary\n9 No reason given\n10 Unable to obtain necessary documentation\n11 Strike\n12 Weather\n13 Natural disaster\n14 Unacceptable reaccommodation\n15 Equipment change\n16 Other"
            },
            "UpdateOrder": {
              "properties": {
                "ReshopOrder": {
                  "properties": {
                    "ServiceOrder": {
                      "properties": {
                        "Add": {
                          "properties": {
                            "OriginDestList": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/OriginDestRequestType2"
                              },
                              "minItems": 0
                            },
                            "Cabin": {
                              "type": "string",
                              "description": "Cabin class\nex) Y: economy\nex) W: premium economy\nex) C: business\nex) F: first"
                            },
                            "ShoppingResponse": {
                              "properties": {
                                "ResponseRefID": {
                                  "type": "string",
                                  "description": "responseID returned by OrderReshop (Reshop)"
                                },
                                "OfferRefID": {
                                  "type": "string",
                                  "description": "OfferID selected among offers returned by OrderReshop (Reshop)"
                                }
                              },
                              "type": "object"
                            },
                            "Criteria": {
                              "$ref": "#/components/schemas/CriteriaType4",
                              "description": "Apply special fare"
                            }
                          },
                          "type": "object",
                          "description": "Flight shopping information for adding an itinerary"
                        },
                        "Delete": {
                          "type": "array",
                          "items": {
                            "properties": {
                              "OrderItemRefID": {
                                "type": "string",
                                "description": "OrderItemID to delete"
                              },
                              "RetainServiceID": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "minItems": 0,
                                "description": "ServiceID to retain (*only for partial itinerary change)"
                              }
                            },
                            "required": [
                              "OrderItemRefID"
                            ],
                            "type": "object"
                          },
                          "minItems": 0,
                          "description": "Delete list"
                        }
                      },
                      "type": "object"
                    },
                    "UpdatePaxName": {
                      "type": "array",
                      "items": {
                        "properties": {
                          "PaxRefID": {
                            "type": "string"
                          },
                          "NameTitle": {
                            "type": "string"
                          },
                          "GivenName": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 5,
                            "minItems": 0
                          },
                          "MiddleName": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 3,
                            "minItems": 0
                          },
                          "Surname": {
                            "type": "string"
                          },
                          "SurnameSuffix": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "PaxRefID"
                        ],
                        "type": "object"
                      },
                      "minItems": 0
                    }
                  },
                  "type": "object"
                },
                "RepricedOrderRefID": {
                  "type": "string",
                  "description": "OrderID to be repriced"
                },
                "CancelOrderRefID": {
                  "type": "string",
                  "description": "OrderID to be canceled"
                }
              },
              "type": "object",
              "description": "OrderReshop case selection (choose exactly one of the cases below)"
            },
            "Criteria": {
              "$ref": "#/components/schemas/CriteriaType4",
              "description": "Apply special fare"
            },
            "ResponseParameter": {
              "$ref": "#/components/schemas/ResponseParameterType5"
            }
          },
          "required": [
            "OrderID",
            "UpdateOrder"
          ],
          "type": "object"
        }
      },
      "required": [
        "Sender",
        "PointOfSale",
        "TransactionID",
        "Query"
      ],
      "type": "object"
    },
    "TravelAgencyType1": {
      "type": "object",
      "properties": {
        "AgencyID": {
          "type": "string",
          "description": "Unique identifier for the travel agency (e.g., YOUR_TENANT_ID)"
        },
        "SiteCode": {
          "type": "string",
          "description": "Site code (e.g., 01, 51 ...)"
        },
        "AgencyName": {
          "type": "string",
          "description": "Name of the travel agency"
        },
        "ContactInfoRefID": {
          "type": "array",
          "description": "Reference ID for travel agency contact information. For certain airlines (e.g., BA, AF, KL), providing specific contact details is mandatory for OrderCreateRQ and OrderChangeRQ messages. Failure to provide this information will result in an error. \n• OrderCreateRQ Requirements:\n  - British Airways (BA): Agency email, postal address\n  - Air France (AF), KLM (KL): Agency email, phone number\n• OrderChangeRQ Requirements:\n  - British Airways (BA): Agency email, postal address",
          "items": {
            "type": "string",
            "description": "An individual reference ID for contact information. This ID links to detailed contact information that may be mandatory for specific airline NDC requests. For example, when creating or changing an order: \n\n•   OrderCreateRQ:\n    -   British Airways (BA): Requires agency email and postal address.\n    -   Air France (AF), KLM (KL): Requires agency email and phone number.\n•   OrderChangeRQ:\n    -   British Airways (BA): Requires agency email and postal address.\n\nFailure to provide required contact details for these airlines will result in a processing error."
          },
          "minItems": 0
        }
      },
      "title": "TravelAgencyType",
      "description": "Information pertaining to the Travel Agency in the context of NDC transactions.",
      "$id": "https://example.com/schemas/TravelAgencyType",
      "required": [
        "AgencyID"
      ]
    },
    "CriteriaType4": {
      "$id": "https://example.com/schemas/CriteriaType",
      "title": "CriteriaType",
      "type": "object",
      "description": "Search and filter criteria",
      "properties": {
        "Direct": {
          "type": "boolean",
          "description": "Whether to search for direct flights only (true = direct flights only)"
        },
        "AirlinePreference": {
          "type": "object",
          "description": "Preferred airline information",
          "properties": {
            "AirlineID": {
              "type": "array",
              "description": "List of preferred airline codes",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ProgramCriteria": {
          "type": "array",
          "description": "Criteria for applying specific programs",
          "items": {
            "type": "object",
            "properties": {
              "ContractID": {
                "type": "string",
                "description": "Contract ID"
              },
              "AccountID": {
                "type": "array",
                "description": "List of account IDs",
                "items": {
                  "type": "string"
                }
              },
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              },
              "TypeCode": {
                "type": "string",
                "description": "Type code"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "PromotionCriteria": {
          "type": "array",
          "description": "Criteria for applying promotions",
          "items": {
            "type": "object",
            "properties": {
              "PromotionID": {
                "type": "string",
                "description": "Promotion ID"
              },
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "SpecialFareCriteria": {
          "type": "array",
          "description": "Criteria for applying special fares",
          "items": {
            "type": "object",
            "properties": {
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              },
              "AccountID": {
                "type": "string",
                "description": "Account ID"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "ExistingOrderCriteria": {
          "type": "object",
          "description": "Criteria for referencing an existing order",
          "properties": {
            "OrderID": {
              "type": "string",
              "description": "Order ID"
            },
            "PaxRefID": {
              "type": "array",
              "description": "List of passenger reference IDs",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "OrderID",
            "PaxRefID"
          ]
        }
      }
    },
    "OriginDestRequestType2": {
      "$id": "https://example.com/schemas/OriginDestType",
      "title": "OriginDestType",
      "type": "object",
      "description": "Definition of a single Origin–Destination (OD) segment.",
      "properties": {
        "OriginCode": {
          "type": "string",
          "description": "Departure airport code (IATA 3-letter code). Example: ICN, BKK, LHR"
        },
        "DestCode": {
          "type": "string",
          "description": "Arrival airport code (IATA 3-letter code). Example: ICN, BKK, LHR"
        },
        "DepartureDate": {
          "type": "string",
          "description": "Planned departure date (ISO 8601 format, YYYY-MM-DD). Example: 2023-12-13"
        }
      },
      "required": [
        "OriginCode",
        "DestCode",
        "DepartureDate"
      ]
    },
    "ResponseParameterType5": {
      "$id": "https://example.com/schemas/ResponseParameterType",
      "title": "ResponseParameterType",
      "type": "object",
      "properties": {
        "CurrencyCode": {
          "type": "string",
          "description": "Currency code (3-letter ISO 4217). Example: KRW, EUR, USD"
        },
        "LanguageUsage": {
          "type": "object",
          "properties": {
            "LangCode": {
              "type": "string",
              "description": "Language code. Example: en, en-US"
            },
            "LangUsageType": {
              "type": "string",
              "description": "Type of language usage (e.g., written, spoken)"
            }
          },
          "required": [
            "LangCode"
          ]
        }
      },
      "required": [
        "CurrencyCode"
      ]
    }
  }
}