{
  "api": "OrderCreate",
  "root_schema": "OrderCreateRQ17",
  "total_schemas": 6,
  "schemas": {
    "OrderCreateRQ17": {
      "type": "object",
      "required": [
        "Sender",
        "PointOfSale",
        "TransactionID",
        "Query"
      ],
      "properties": {
        "Sender": {
          "type": "object",
          "required": [
            "TravelAgency"
          ],
          "properties": {
            "TravelAgency": {
              "$ref": "#/components/schemas/TravelAgencyType1",
              "description": "Travel agency information"
            }
          }
        },
        "PointOfSale": {
          "type": "string",
          "description": "Point of sale"
        },
        "TransactionID": {
          "type": "string",
          "description": "Unique identifier key UUID \nTransaction ID \ne.g., 4ba5a0b50d2c45b3b5eb343b57ba8897\n\n32-digit random number required.\n\nKey value for internal log tracking"
        },
        "Query": {
          "type": "object",
          "required": [
            "Order",
            "PaxList"
          ],
          "properties": {
            "Order": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "OfferID",
                  "Owner",
                  "ResponseID"
                ],
                "properties": {
                  "ResponseID": {
                    "type": "string",
                    "description": "Unique response ID"
                  },
                  "OfferID": {
                    "type": "string",
                    "description": "Unique offer ID"
                  },
                  "Owner": {
                    "type": "string",
                    "description": "Offer owning airline"
                  },
                  "OfferItems": {
                    "type": "array",
                    "description": "List of OfferItems. Each item represents a fare/service unit (OfferItem) proposed during flight shopping.",
                    "items": {
                      "type": "object",
                      "required": [
                        "OfferItemID",
                        "PaxRefID"
                      ],
                      "properties": {
                        "OfferItemID": {
                          "type": "string",
                          "description": "Unique OfferItem ID. Provided in shopping response. e.g., TSDEV-OF-e53058b8-60dc-42e5-902a-15720ad351dd-1"
                        },
                        "PaxRefID": {
                          "type": "array",
                          "description": "Passenger reference IDs associated with this OfferItem. Provided in shopping response. e.g., [\"T1\"]",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1
                        },
                        "SeatSelection": {
                          "type": "object",
                          "description": "Seat selection information (in-flight seat position)",
                          "required": [
                            "Column",
                            "Row"
                          ],
                          "properties": {
                            "Column": {
                              "type": "string",
                              "description": "Seat column. e.g., A, B, C"
                            },
                            "Row": {
                              "type": "string",
                              "description": "Seat row. e.g., 10, 15"
                            }
                          }
                        },
                        "BookingInstructions": {
                          "type": "object",
                          "description": "Booking-related instruction information. Includes SSR, OSI, upgrade, equipment, and other optional booking directives.",
                          "properties": {
                            "SsrCode": {
                              "type": "array",
                              "description": "SSR codes for additional purchasable services. e.g., FBAG, ABAG, XBA, SEAT",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 0
                            },
                            "OsiText": {
                              "type": "array",
                              "description": "Other Service Information (OSI). e.g., \"PAX VIP MEMBER OF PARLIAMENT\"",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 0
                            },
                            "Text": {
                              "type": "array",
                              "description": "Additional text description for booking instructions.",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 0
                            },
                            "UpgradeMethod": {
                              "type": "string",
                              "description": "Information about upgrade methods and procedures."
                            },
                            "Method": {
                              "type": "string",
                              "description": "Specific action or process within optional booking instructions."
                            },
                            "Equipment": {
                              "type": "string",
                              "description": "Equipment or device information related to booking instructions. e.g., when special equipment is required"
                            }
                          }
                        },
                        "Qty": {
                          "type": "number",
                          "description": "Quantity of this OfferItem."
                        },
                        "OfferFlightAssociations": {
                          "type": "object",
                          "description": "Associations of the OfferItem with journey/operating flight references.",
                          "required": [
                            "DatedOperatingLegRefID",
                            "PaxJourneyRefID",
                            "PaxSegmentRefD"
                          ],
                          "properties": {
                            "DatedOperatingLegRefID": {
                              "type": "array",
                              "description": "List of operating leg reference IDs. e.g., [\"LEG1\"]",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 1
                            },
                            "PaxJourneyRefID": {
                              "type": "array",
                              "description": "List of passenger journey reference IDs. e.g., [\"JNY1\"]",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 1
                            },
                            "PaxSegmentRefD": {
                              "type": "array",
                              "description": "List of passenger segment reference IDs. e.g., [\"SEG1\"]",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 1
                            }
                          }
                        }
                      }
                    },
                    "minItems": 0
                  },
                  "FopPromotion": {
                    "type": "array",
                    "description": "List of promotions by Form of Payment (FOP)",
                    "items": {
                      "type": "object",
                      "required": [
                        "PromotionCode"
                      ],
                      "properties": {
                        "PromotionCode": {
                          "type": "string",
                          "description": "Promotion code"
                        },
                        "PaymentType": {
                          "type": "string",
                          "description": "Payment method. e.g., A (Card), C (Cash), K (KakaoPay), S (SamsungPay)"
                        },
                        "TotalPromotionAmount": {
                          "type": "object",
                          "description": "Total promotion amount",
                          "required": [
                            "Amount",
                            "CurCode"
                          ],
                          "properties": {
                            "Amount": {
                              "type": "number",
                              "description": "Total discount/surcharge amount"
                            },
                            "CurCode": {
                              "type": "string",
                              "description": "Currency code (3 letters)"
                            }
                          }
                        },
                        "PtcPromotionAmount": {
                          "type": "array",
                          "description": "List of promotion amounts per passenger type (optional)",
                          "items": {
                            "type": "object",
                            "required": [
                              "Ptc",
                              "Amount"
                            ],
                            "properties": {
                              "Ptc": {
                                "type": "string",
                                "description": "Passenger type"
                              },
                              "Amount": {
                                "type": "object",
                                "description": "Promotion amount for the passenger type",
                                "required": [
                                  "Amount",
                                  "CurCode"
                                ],
                                "properties": {
                                  "Amount": {
                                    "type": "number",
                                    "description": "Discount/surcharge amount"
                                  },
                                  "CurCode": {
                                    "type": "string",
                                    "description": "Currency code (3 letters)"
                                  }
                                }
                              }
                            }
                          },
                          "minItems": 0
                        },
                        "CardCode": {
                          "type": "string",
                          "description": "Card code (output only when PaymentType=A)"
                        },
                        "CardName": {
                          "type": "string",
                          "description": "Card name (output only when PaymentType=A)"
                        }
                      }
                    },
                    "minItems": 0
                  }
                }
              },
              "minItems": 1,
              "description": "List of fare/offer information"
            },
            "PaxList": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PaxType11"
              },
              "minItems": 1,
              "description": "Passenger information list"
            },
            "PaymentList": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PaymentType"
              },
              "minItems": 0,
              "description": "Payment information list"
            },
            "ContactInfoList": {
              "type": "array",
              "description": "Contact information list. Includes passenger/agency email, phone, and postal (residence) address information.",
              "items": {
                "$ref": "#/components/schemas/ContactInfoType"
              },
              "minItems": 0
            },
            "Criteria": {
              "$ref": "#/components/schemas/CriteriaType4",
              "description": "Special fare application"
            }
          }
        }
      }
    },
    "TravelAgencyType1": {
      "type": "object",
      "properties": {
        "AgencyID": {
          "type": "string",
          "description": "Unique identifier for the travel agency (e.g., YOUR_TENANT_ID)"
        },
        "SiteCode": {
          "type": "string",
          "description": "Site code (e.g., 01, 51 ...)"
        },
        "AgencyName": {
          "type": "string",
          "description": "Name of the travel agency"
        },
        "ContactInfoRefID": {
          "type": "array",
          "description": "Reference ID for travel agency contact information. For certain airlines (e.g., BA, AF, KL), providing specific contact details is mandatory for OrderCreateRQ and OrderChangeRQ messages. Failure to provide this information will result in an error. \n• OrderCreateRQ Requirements:\n  - British Airways (BA): Agency email, postal address\n  - Air France (AF), KLM (KL): Agency email, phone number\n• OrderChangeRQ Requirements:\n  - British Airways (BA): Agency email, postal address",
          "items": {
            "type": "string",
            "description": "An individual reference ID for contact information. This ID links to detailed contact information that may be mandatory for specific airline NDC requests. For example, when creating or changing an order: \n\n•   OrderCreateRQ:\n    -   British Airways (BA): Requires agency email and postal address.\n    -   Air France (AF), KLM (KL): Requires agency email and phone number.\n•   OrderChangeRQ:\n    -   British Airways (BA): Requires agency email and postal address.\n\nFailure to provide required contact details for these airlines will result in a processing error."
          },
          "minItems": 0
        }
      },
      "title": "TravelAgencyType",
      "description": "Information pertaining to the Travel Agency in the context of NDC transactions.",
      "$id": "https://example.com/schemas/TravelAgencyType",
      "required": [
        "AgencyID"
      ]
    },
    "CriteriaType4": {
      "$id": "https://example.com/schemas/CriteriaType",
      "title": "CriteriaType",
      "type": "object",
      "description": "Search and filter criteria",
      "properties": {
        "Direct": {
          "type": "boolean",
          "description": "Whether to search for direct flights only (true = direct flights only)"
        },
        "AirlinePreference": {
          "type": "object",
          "description": "Preferred airline information",
          "properties": {
            "AirlineID": {
              "type": "array",
              "description": "List of preferred airline codes",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ProgramCriteria": {
          "type": "array",
          "description": "Criteria for applying specific programs",
          "items": {
            "type": "object",
            "properties": {
              "ContractID": {
                "type": "string",
                "description": "Contract ID"
              },
              "AccountID": {
                "type": "array",
                "description": "List of account IDs",
                "items": {
                  "type": "string"
                }
              },
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              },
              "TypeCode": {
                "type": "string",
                "description": "Type code"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "PromotionCriteria": {
          "type": "array",
          "description": "Criteria for applying promotions",
          "items": {
            "type": "object",
            "properties": {
              "PromotionID": {
                "type": "string",
                "description": "Promotion ID"
              },
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "SpecialFareCriteria": {
          "type": "array",
          "description": "Criteria for applying special fares",
          "items": {
            "type": "object",
            "properties": {
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              },
              "AccountID": {
                "type": "string",
                "description": "Account ID"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "ExistingOrderCriteria": {
          "type": "object",
          "description": "Criteria for referencing an existing order",
          "properties": {
            "OrderID": {
              "type": "string",
              "description": "Order ID"
            },
            "PaxRefID": {
              "type": "array",
              "description": "List of passenger reference IDs",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "OrderID",
            "PaxRefID"
          ]
        }
      }
    },
    "PaymentType": {
      "$id": "https://example.com/schemas/PaymentType.schema.json",
      "title": "PaymentType",
      "type": "object",
      "description": "Common payment type. Based on IATA NDC 21.3, includes payment type, amount, currency, and card/easy payment details.",
      "additionalProperties": false,
      "required": [
        "Type",
        "Amount",
        "CurCode"
      ],
      "properties": {
        "Type": {
          "type": "string",
          "description": "Payment type code. Examples: 'CA' (Cash), 'CC' (Credit Card), 'EP' (EasyPay). Example: CA"
        },
        "Amount": {
          "type": "number",
          "description": "Payment amount (decimals allowed). Example: 1474000"
        },
        "CurCode": {
          "type": "string",
          "description": "Currency (ISO 4217, 3 uppercase letters). Example: KRW, EUR, USD",
          "pattern": "^[A-Z]{3}$"
        },
        "PaymentCardMethod": {
          "type": "object",
          "description": "Payment information (Card). Used for credit card transactions.",
          "additionalProperties": false,
          "properties": {
            "CardCode": {
              "type": "string",
              "description": "Card code (brand/internal code). Example: VISA, MC, AMEX"
            },
            "CardNumber": {
              "type": "string",
              "description": "Card number (masked if required). Example: 411111******1111"
            },
            "CardHolderName": {
              "type": "string",
              "description": "Cardholder name. Example: KIM MIN SU"
            },
            "ApprovalCode": {
              "type": "string",
              "description": "Authorization code (transaction approval code). Example: 123456"
            },
            "CardQuota": {
              "type": "integer",
              "description": "Installment months. 0 or 1 means lump sum. Example: 0, 3, 6, 12"
            },
            "EffectiveExpireDate": {
              "type": "object",
              "description": "Effective/expiration date information.",
              "additionalProperties": false,
              "required": [
                "Effective",
                "Expiration"
              ],
              "properties": {
                "Effective": {
                  "type": "string",
                  "description": "Effective start date (YYYY-MM-DD or YYYY-MM). Example: 2025-01"
                },
                "Expiration": {
                  "type": "string",
                  "description": "Expiration date (YYYY-MM or YYYY-MM-DD). Example: 2028-12"
                }
              }
            },
            "SeriesCode": {
              "type": "string",
              "description": "Card identification number (e.g., BIN or serial). Example: 9412"
            }
          }
        },
        "PaymentEasyPayMethod": {
          "type": "object",
          "description": "Payment information (EasyPay / e-wallet).",
          "additionalProperties": false,
          "properties": {
            "CardCode": {
              "type": "string",
              "description": "Card code linked to EasyPay. Example: VISA"
            },
            "CardNumber": {
              "type": "string",
              "description": "Masked EasyPay card number. Example: 4100********0000"
            },
            "CardHolderName": {
              "type": "string",
              "description": "Cardholder name. Example: KIM MIN SU"
            },
            "SeriesCode": {
              "type": "string",
              "description": "Card identification number. Example: 9412"
            },
            "OrderNumber": {
              "type": "string",
              "description": "EasyPay order number (internal/PG order key, booking reference). Example: EP-20250101-000123"
            },
            "EncDate": {
              "type": "string",
              "description": "Encrypted data (token/ciphertext)."
            },
            "IssueCountry": {
              "type": "string",
              "description": "Card issuing country (ISO 3166-1 alpha-2/3 recommended). Example: KR, KOR"
            },
            "PaymentPlan": {
              "type": "string",
              "description": "Installment plan. Example: 00 (lump sum), 03, 06"
            },
            "Birthday": {
              "type": "string",
              "description": "Cardholder’s date of birth (sensitive information, must comply with regulations). Example: 19900101"
            },
            "CardPassword": {
              "type": "string",
              "description": "First 2 digits of card PIN (sensitive, must be masked in storage/logs). Example: 12"
            },
            "Email": {
              "type": "string",
              "description": "Cardholder email. Example: user@example.com",
              "format": "email"
            }
          }
        },
        "Status": {
          "type": "string",
          "description": "Payment status code. Example: 395"
        },
        "PaxRefID": {
          "type": "array",
          "description": "List of passenger reference IDs. Example: [\"PAX1\",\"PAX2\"]",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "OrderItemID": {
          "type": "array",
          "description": "List of order item IDs. Example: [\"PoIP676BC2CD-86EA-4E50-97C6-1-1\"]",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "OfferItemID": {
          "type": "array",
          "description": "List of offer item IDs.",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "example": {
        "Type": "CA",
        "Amount": 1474000,
        "CurCode": "KRW",
        "Status": "395",
        "PaxRefID": [],
        "OrderItemID": [
          "PoIP676BC2CD-86EA-4E50-97C6-1-1"
        ]
      }
    },
    "ContactInfoType": {
      "$id": "https://example.com/schemas/ContactInfoType.schema.json",
      "title": "ContactInfoType",
      "type": "object",
      "description": "Common contact information type. Includes passenger or agency email, phone, and postal address details.",
      "additionalProperties": false,
      "required": [
        "ContactInfoID"
      ],
      "properties": {
        "ContactInfoID": {
          "type": "string",
          "description": "Unique contact information identifier. Example: \"CI1\", \"CTC_TA1\"."
        },
        "EmailAddress": {
          "type": "array",
          "description": "List of email addresses. May be required by airline. Example: [\"agency@example.com\"].",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "Phone": {
          "type": "array",
          "description": "List of phone numbers. Multiple numbers can be included with labels.",
          "items": {
            "type": "object",
            "properties": {
              "Label": {
                "type": "string",
                "description": "Phone number label. Example: \"Mobile\", \"HOME\", \"Operational\"."
              },
              "CountryDialingCode": {
                "type": "string",
                "description": "International dialing country code. Example: \"82\", \"1\"."
              },
              "AreaCode": {
                "type": "string",
                "description": "Area code. Example: \"2\", \"813\"."
              },
              "PhoneNumber": {
                "type": "string",
                "description": "Phone number. Free format allowed. Example: \"+1 999-999-9999 ext 1234\"."
              },
              "Extension": {
                "type": "string",
                "description": "Extension number. Example: \"1234\"."
              }
            }
          },
          "minItems": 0
        },
        "ContactRefusedInd": {
          "type": "boolean",
          "description": "Indicates refusal of contact. If true, Email/Phone must not be provided."
        },
        "PostalAddress": {
          "type": "array",
          "description": "Postal/residential address information. Mandatory in some routes (APIS).",
          "items": {
            "type": "object",
            "properties": {
              "Label": {
                "type": "string",
                "description": "Address label. Example: \"HOME\", \"Operational\", \"AddressAtDestination\"."
              },
              "Street": {
                "type": "array",
                "description": "Street/Detail address (max 2 lines). Example: [\"201 W 79th St\"].",
                "items": {
                  "type": "string"
                },
                "maxItems": 2,
                "minItems": 0
              },
              "BuildingRoom": {
                "type": "string",
                "description": "Building/Room information."
              },
              "PoBox": {
                "type": "string",
                "description": "PO Box number."
              },
              "PostalCode": {
                "type": "string",
                "description": "Postal code. Example: \"10024\"."
              },
              "CityName": {
                "type": "string",
                "description": "City name. Example: \"NYK\", \"Seoul\"."
              },
              "CountrySubdivisionName": {
                "type": "string",
                "description": "Country subdivision name (state/province/district)."
              },
              "CountryName": {
                "type": "string",
                "description": "Country name (full name)."
              },
              "CountryCode": {
                "type": "string",
                "description": "Country code (ISO). Example: \"US\", \"KR\"."
              }
            }
          },
          "minItems": 0
        }
      },
      "example": {
        "ContactInfoID": "CI1",
        "EmailAddress": [
          "user@example.com"
        ],
        "Phone": [
          {
            "Label": "Mobile",
            "CountryDialingCode": "82",
            "AreaCode": "2",
            "PhoneNumber": "12345678",
            "Extension": "1234"
          }
        ],
        "ContactRefusedInd": false,
        "PostalAddress": [
          {
            "Label": "HOME",
            "Street": [
              "201 W 79th St"
            ],
            "CityName": "Seoul",
            "CountryCode": "KR"
          }
        ]
      }
    },
    "PaxType11": {
      "$id": "https://example.com/schemas/PaxType",
      "title": "PaxType",
      "type": "object",
      "required": [
        "PaxID",
        "Ptc"
      ],
      "properties": {
        "PaxID": {
          "type": "string",
          "description": "Unique passenger identifier. Example: PAX1, T1"
        },
        "Ptc": {
          "type": "string",
          "description": "Passenger type code. Example: ADT (Adult), CHD (Child), INF (Infant)"
        },
        "Individual": {
          "type": "object",
          "description": "Personal (biographical) information.",
          "required": [
            "Surname"
          ],
          "properties": {
            "IndividualID": {
              "type": "string",
              "description": "Individual identifier (optional)."
            },
            "Birthdate": {
              "type": "string",
              "description": "Date of birth (YYYY-MM-DD)."
            },
            "Birthplace": {
              "type": "string",
              "description": "Place of birth."
            },
            "Gender": {
              "type": "string",
              "enum": [
                "Female",
                "Male",
                "Unspecified"
              ],
              "description": "Gender."
            },
            "NameTitle": {
              "type": "string",
              "description": "Title. Example: MR / MRS / MS"
            },
            "GivenName": {
              "type": "array",
              "description": "Given names (multiple allowed).",
              "items": {
                "type": "string"
              },
              "maxItems": 5,
              "minItems": 0
            },
            "MiddleName": {
              "type": "array",
              "description": "Middle names (multiple allowed).",
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 0
            },
            "Surname": {
              "type": "string",
              "description": "Surname."
            },
            "SurnameSuffix": {
              "type": "string",
              "description": "Surname suffix."
            }
          }
        },
        "ContactInfoRefID": {
          "type": "array",
          "description": "List of ContactInfo reference IDs.",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "Gender": {
          "type": "string",
          "enum": [
            "Female",
            "Male",
            "Unspecified"
          ],
          "description": "Gender (if duplicated with Individual, apply precedence rules)."
        },
        "ResidenceCountryCode": {
          "type": "string",
