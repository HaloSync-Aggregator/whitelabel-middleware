{
  "api": "OrderChange",
  "root_schema": "OrderChangeRQ29",
  "total_schemas": 7,
  "schemas": {
    "OrderChangeRQ29": {
      "$id": "https://example.com/OrderChangeRQ",
      "title": "OrderChangeRQ",
      "type": "object",
      "required": [
        "Sender",
        "PointOfSale",
        "TransactionID",
        "Query"
      ],
      "properties": {
        "Sender": {
          "type": "object",
          "required": [
            "TravelAgency"
          ],
          "properties": {
            "TravelAgency": {
              "description": "Travel agency information",
              "$ref": "#/components/schemas/TravelAgencyType1"
            }
          }
        },
        "PointOfSale": {
          "type": "string",
          "description": "Point of sale"
        },
        "TransactionID": {
          "type": "string",
          "description": "Unique identifier key UUID \nTransaction ID \ne.g., 4ba5a0b50d2c45b3b5eb343b57ba8897\n\n32-digit random number required.\n\nKey value for internal log tracking"
        },
        "Query": {
          "type": "object",
          "required": [
            "OrderID"
          ],
          "properties": {
            "OrderID": {
              "type": "string",
              "description": "Unique order identifier"
            },
            "ReasonCode": {
              "type": "string",
              "description": "Involuntary ticket acceptance code\n\nWhen set to *DIV, it is recognized as Order Split. *104, it is recognized as Order Reserve\n"
            },
            "ChangeOrderChoice": {
              "type": "object",
              "required": [
                "UpdatePax"
              ],
              "properties": {
                "AcceptOrderItemList": {
                  "type": "object",
                  "required": [
                    "Owner"
                  ],
                  "properties": {
                    "OfferItemRefID": {
                      "type": "string"
                    },
                    "PriceGuaranteeTimeLimit": {
                      "type": "string"
                    },
                    "Owner": {
                      "type": "string"
                    },
                    "WebAddressURI": {
                      "type": "string"
                    }
                  }
                },
                "AcceptCancelledOffer": {
                  "type": "object",
                  "required": [
                    "OfferID",
                    "Owner"
                  ],
                  "properties": {
                    "OfferID": {
                      "type": "string",
                      "description": "OfferID"
                    },
                    "Owner": {
                      "type": "string",
                      "description": "Airline owner"
                    }
                  },
                  "description": "Mandatory when processing ancillary refund cases"
                },
                "AcceptChange": {
                  "type": "object",
                  "required": [
                    "OrderItemRefID"
                  ],
                  "properties": {
                    "OrderItemRefID": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "description": "OrderItemID"
                    }
                  },
                  "description": "Mandatory when processing involuntary change acceptance cases"
                },
                "AcceptRepricedOrder": {
                  "type": "object",
                  "required": [
                    "OfferRefID"
                  ],
                  "properties": {
                    "OfferRefID": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "description": "If Offer exists in OrderReshopRS: set OfferRefID as OfferRefID\nIf Offer does not exist in OrderReshopRS: set OrderID as OfferRefID"
                    }
                  },
                  "description": "Mandatory when accepting changes during fare recalculation"
                },
                "AcceptSelectedQuotedOfferList": {
                  "type": "object",
                  "required": [
                    "SelectedPricedOffer"
                  ],
                  "properties": {
                    "SelectedPricedOffer": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrderOfferType9"
                      },
                      "minItems": 1,
                      "description": "Select Offer or ALaCarteOffer (ServiceList, SeatAvailability, etc.) delivered from various shopping responses"
                    }
                  },
                  "description": "Mandatory when handling itinerary changes and ancillary purchases"
                },
                "CancelUnpaidOrder": {
                  "type": "object",
                  "required": [
                    "OrderRefID",
                    "Owner"
                  ],
                  "properties": {
                    "OrderRefID": {
                      "type": "string",
                      "description": "Booking number"
                    },
                    "Owner": {
                      "type": "string",
                      "description": "Airline owner"
                    },
                    "SelectedOrderItemRefID": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 0,
                      "description": "OrderItemID of unpaid ancillary to cancel"
                    }
                  },
                  "description": "Mandatory when handling free ancillary cancellations"
                },
                "UpdatePax": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "CurrentPaxRefID": {
                        "type": "string",
                        "description": "List of PAX to modify or delete"
                      },
                      "NewPaxRefID": {
                        "type": "string",
                        "description": "List of new PAX to add"
                      }
                    }
                  },
                  "minItems": 1,
                  "description": "Mandatory when handling passenger info changes or split cases"
                }
              },
              "description": "Distinguishes OrderChange by case (one of the below cases must be selected)"
            },
            "PaxList": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PaxType11"
              },
              "minItems": 0,
              "description": "Passenger information list"
            },
            "ContactInfoList": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ContactInfoType"
              },
              "minItems": 0,
              "description": "Contact information list"
            },
            "PaymentList": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PaymentType"
              },
              "minItems": 0,
              "description": "Payment information list"
            },
            "Criteria": {
              "$ref": "#/components/schemas/CriteriaType4",
              "description": "Special fare application"
            }
          }
        }
      }
    },
    "TravelAgencyType1": {
      "type": "object",
      "properties": {
        "AgencyID": {
          "type": "string",
          "description": "Unique identifier for the travel agency (e.g., YOUR_TENANT_ID)"
        },
        "SiteCode": {
          "type": "string",
          "description": "Site code (e.g., 01, 51 ...)"
        },
        "AgencyName": {
          "type": "string",
          "description": "Name of the travel agency"
        },
        "ContactInfoRefID": {
          "type": "array",
          "description": "Reference ID for travel agency contact information. For certain airlines (e.g., BA, AF, KL), providing specific contact details is mandatory for OrderCreateRQ and OrderChangeRQ messages. Failure to provide this information will result in an error. \n• OrderCreateRQ Requirements:\n  - British Airways (BA): Agency email, postal address\n  - Air France (AF), KLM (KL): Agency email, phone number\n• OrderChangeRQ Requirements:\n  - British Airways (BA): Agency email, postal address",
          "items": {
            "type": "string",
            "description": "An individual reference ID for contact information. This ID links to detailed contact information that may be mandatory for specific airline NDC requests. For example, when creating or changing an order: \n\n•   OrderCreateRQ:\n    -   British Airways (BA): Requires agency email and postal address.\n    -   Air France (AF), KLM (KL): Requires agency email and phone number.\n•   OrderChangeRQ:\n    -   British Airways (BA): Requires agency email and postal address.\n\nFailure to provide required contact details for these airlines will result in a processing error."
          },
          "minItems": 0
        }
      },
      "title": "TravelAgencyType",
      "description": "Information pertaining to the Travel Agency in the context of NDC transactions.",
      "$id": "https://example.com/schemas/TravelAgencyType",
      "required": [
        "AgencyID"
      ]
    },
    "CriteriaType4": {
      "$id": "https://example.com/schemas/CriteriaType",
      "title": "CriteriaType",
      "type": "object",
      "description": "Search and filter criteria",
      "properties": {
        "Direct": {
          "type": "boolean",
          "description": "Whether to search for direct flights only (true = direct flights only)"
        },
        "AirlinePreference": {
          "type": "object",
          "description": "Preferred airline information",
          "properties": {
            "AirlineID": {
              "type": "array",
              "description": "List of preferred airline codes",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ProgramCriteria": {
          "type": "array",
          "description": "Criteria for applying specific programs",
          "items": {
            "type": "object",
            "properties": {
              "ContractID": {
                "type": "string",
                "description": "Contract ID"
              },
              "AccountID": {
                "type": "array",
                "description": "List of account IDs",
                "items": {
                  "type": "string"
                }
              },
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              },
              "TypeCode": {
                "type": "string",
                "description": "Type code"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "PromotionCriteria": {
          "type": "array",
          "description": "Criteria for applying promotions",
          "items": {
            "type": "object",
            "properties": {
              "PromotionID": {
                "type": "string",
                "description": "Promotion ID"
              },
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "SpecialFareCriteria": {
          "type": "array",
          "description": "Criteria for applying special fares",
          "items": {
            "type": "object",
            "properties": {
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              },
              "AccountID": {
                "type": "string",
                "description": "Account ID"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "ExistingOrderCriteria": {
          "type": "object",
          "description": "Criteria for referencing an existing order",
          "properties": {
            "OrderID": {
              "type": "string",
              "description": "Order ID"
            },
            "PaxRefID": {
              "type": "array",
              "description": "List of passenger reference IDs",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "OrderID",
            "PaxRefID"
          ]
        }
      }
    },
    "PaymentType": {
      "$id": "https://example.com/schemas/PaymentType.schema.json",
      "title": "PaymentType",
      "type": "object",
      "description": "Common payment type. Based on IATA NDC 21.3, includes payment type, amount, currency, and card/easy payment details.",
      "additionalProperties": false,
      "required": [
        "Type",
        "Amount",
        "CurCode"
      ],
      "properties": {
        "Type": {
          "type": "string",
          "description": "Payment type code. Examples: 'CA' (Cash), 'CC' (Credit Card), 'EP' (EasyPay). Example: CA"
        },
        "Amount": {
          "type": "number",
          "description": "Payment amount (decimals allowed). Example: 1474000"
        },
        "CurCode": {
          "type": "string",
          "description": "Currency (ISO 4217, 3 uppercase letters). Example: KRW, EUR, USD",
          "pattern": "^[A-Z]{3}$"
        },
        "PaymentCardMethod": {
          "type": "object",
          "description": "Payment information (Card). Used for credit card transactions.",
          "additionalProperties": false,
          "properties": {
            "CardCode": {
              "type": "string",
              "description": "Card code (brand/internal code). Example: VISA, MC, AMEX"
            },
            "CardNumber": {
              "type": "string",
              "description": "Card number (masked if required). Example: 411111******1111"
            },
            "CardHolderName": {
              "type": "string",
              "description": "Cardholder name. Example: KIM MIN SU"
            },
            "ApprovalCode": {
              "type": "string",
              "description": "Authorization code (transaction approval code). Example: 123456"
            },
            "CardQuota": {
              "type": "integer",
              "description": "Installment months. 0 or 1 means lump sum. Example: 0, 3, 6, 12"
            },
            "EffectiveExpireDate": {
              "type": "object",
              "description": "Effective/expiration date information.",
              "additionalProperties": false,
              "required": [
                "Effective",
                "Expiration"
              ],
              "properties": {
                "Effective": {
                  "type": "string",
                  "description": "Effective start date (YYYY-MM-DD or YYYY-MM). Example: 2025-01"
                },
                "Expiration": {
                  "type": "string",
                  "description": "Expiration date (YYYY-MM or YYYY-MM-DD). Example: 2028-12"
                }
              }
            },
            "SeriesCode": {
              "type": "string",
              "description": "Card identification number (e.g., BIN or serial). Example: 9412"
            }
          }
        },
        "PaymentEasyPayMethod": {
          "type": "object",
          "description": "Payment information (EasyPay / e-wallet).",
          "additionalProperties": false,
          "properties": {
            "CardCode": {
              "type": "string",
              "description": "Card code linked to EasyPay. Example: VISA"
            },
            "CardNumber": {
              "type": "string",
              "description": "Masked EasyPay card number. Example: 4100********0000"
            },
            "CardHolderName": {
              "type": "string",
              "description": "Cardholder name. Example: KIM MIN SU"
            },
            "SeriesCode": {
              "type": "string",
              "description": "Card identification number. Example: 9412"
            },
            "OrderNumber": {
              "type": "string",
              "description": "EasyPay order number (internal/PG order key, booking reference). Example: EP-20250101-000123"
            },
            "EncDate": {
              "type": "string",
              "description": "Encrypted data (token/ciphertext)."
            },
            "IssueCountry": {
              "type": "string",
              "description": "Card issuing country (ISO 3166-1 alpha-2/3 recommended). Example: KR, KOR"
            },
            "PaymentPlan": {
              "type": "string",
              "description": "Installment plan. Example: 00 (lump sum), 03, 06"
            },
            "Birthday": {
              "type": "string",
              "description": "Cardholder’s date of birth (sensitive information, must comply with regulations). Example: 19900101"
            },
            "CardPassword": {
              "type": "string",
              "description": "First 2 digits of card PIN (sensitive, must be masked in storage/logs). Example: 12"
            },
            "Email": {
              "type": "string",
              "description": "Cardholder email. Example: user@example.com",
              "format": "email"
            }
          }
        },
        "Status": {
          "type": "string",
          "description": "Payment status code. Example: 395"
        },
        "PaxRefID": {
          "type": "array",
          "description": "List of passenger reference IDs. Example: [\"PAX1\",\"PAX2\"]",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "OrderItemID": {
          "type": "array",
          "description": "List of order item IDs. Example: [\"PoIP676BC2CD-86EA-4E50-97C6-1-1\"]",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "OfferItemID": {
          "type": "array",
          "description": "List of offer item IDs.",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "example": {
        "Type": "CA",
        "Amount": 1474000,
        "CurCode": "KRW",
        "Status": "395",
        "PaxRefID": [],
        "OrderItemID": [
          "PoIP676BC2CD-86EA-4E50-97C6-1-1"
        ]
      }
    },
    "ContactInfoType": {
      "$id": "https://example.com/schemas/ContactInfoType.schema.json",
      "title": "ContactInfoType",
      "type": "object",
      "description": "Common contact information type. Includes passenger or agency email, phone, and postal address details.",
      "additionalProperties": false,
      "required": [
        "ContactInfoID"
      ],
      "properties": {
        "ContactInfoID": {
          "type": "string",
          "description": "Unique contact information identifier. Example: \"CI1\", \"CTC_TA1\"."
        },
        "EmailAddress": {
          "type": "array",
          "description": "List of email addresses. May be required by airline. Example: [\"agency@example.com\"].",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "Phone": {
          "type": "array",
          "description": "List of phone numbers. Multiple numbers can be included with labels.",
          "items": {
            "type": "object",
            "properties": {
              "Label": {
                "type": "string",
                "description": "Phone number label. Example: \"Mobile\", \"HOME\", \"Operational\"."
              },
              "CountryDialingCode": {
                "type": "string",
                "description": "International dialing country code. Example: \"82\", \"1\"."
              },
              "AreaCode": {
                "type": "string",
                "description": "Area code. Example: \"2\", \"813\"."
              },
              "PhoneNumber": {
                "type": "string",
                "description": "Phone number. Free format allowed. Example: \"+1 999-999-9999 ext 1234\"."
              },
              "Extension": {
                "type": "string",
                "description": "Extension number. Example: \"1234\"."
              }
            }
          },
          "minItems": 0
        },
        "ContactRefusedInd": {
          "type": "boolean",
          "description": "Indicates refusal of contact. If true, Email/Phone must not be provided."
        },
        "PostalAddress": {
          "type": "array",
          "description": "Postal/residential address information. Mandatory in some routes (APIS).",
          "items": {
            "type": "object",
            "properties": {
              "Label": {
                "type": "string",
                "description": "Address label. Example: \"HOME\", \"Operational\", \"AddressAtDestination\"."
              },
              "Street": {
                "type": "array",
                "description": "Street/Detail address (max 2 lines). Example: [\"201 W 79th St\"].",
                "items": {
                  "type": "string"
                },
                "maxItems": 2,
                "minItems": 0
              },
              "BuildingRoom": {
                "type": "string",
                "description": "Building/Room information."
              },
              "PoBox": {
                "type": "string",
                "description": "PO Box number."
              },
              "PostalCode": {
                "type": "string",
                "description": "Postal code. Example: \"10024\"."
              },
              "CityName": {
                "type": "string",
                "description": "City name. Example: \"NYK\", \"Seoul\"."
              },
              "CountrySubdivisionName": {
                "type": "string",
                "description": "Country subdivision name (state/province/district)."
              },
              "CountryName": {
                "type": "string",
                "description": "Country name (full name)."
              },
              "CountryCode": {
                "type": "string",
                "description": "Country code (ISO). Example: \"US\", \"KR\"."
              }
            }
          },
          "minItems": 0
        }
      },
      "example": {
        "ContactInfoID": "CI1",
        "EmailAddress": [
          "user@example.com"
        ],
        "Phone": [
          {
            "Label": "Mobile",
            "CountryDialingCode": "82",
            "AreaCode": "2",
            "PhoneNumber": "12345678",
            "Extension": "1234"
          }
        ],
        "ContactRefusedInd": false,
        "PostalAddress": [
          {
            "Label": "HOME",
            "Street": [
              "201 W 79th St"
            ],
            "CityName": "Seoul",
            "CountryCode": "KR"
          }
        ]
      }
    },
    "PaxType11": {
      "$id": "https://example.com/schemas/PaxType",
      "title": "PaxType",
      "type": "object",
      "required": [
        "PaxID",
        "Ptc"
      ],
      "properties": {
        "PaxID": {
          "type": "string",
          "description": "Unique passenger identifier. Example: PAX1, T1"
        },
        "Ptc": {
          "type": "string",
          "description": "Passenger type code. Example: ADT (Adult), CHD (Child), INF (Infant)"
        },
        "Individual": {
          "type": "object",
          "description": "Personal (biographical) information.",
          "required": [
            "Surname"
          ],
          "properties": {
            "IndividualID": {
              "type": "string",
              "description": "Individual identifier (optional)."
            },
            "Birthdate": {
              "type": "string",
              "description": "Date of birth (YYYY-MM-DD)."
            },
            "Birthplace": {
              "type": "string",
              "description": "Place of birth."
            },
            "Gender": {
              "type": "string",
              "enum": [
                "Female",
                "Male",
                "Unspecified"
              ],
              "description": "Gender."
            },
            "NameTitle": {
              "type": "string",
              "description": "Title. Example: MR / MRS / MS"
            },
            "GivenName": {
              "type": "array",
              "description": "Given names (multiple allowed).",
              "items": {
                "type": "string"
              },
              "maxItems": 5,
              "minItems": 0
            },
            "MiddleName": {
              "type": "array",
              "description": "Middle names (multiple allowed).",
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 0
            },
            "Surname": {
              "type": "string",
              "description": "Surname."
            },
            "SurnameSuffix": {
              "type": "string",
              "description": "Surname suffix."
            }
          }
        },
        "ContactInfoRefID": {
          "type": "array",
          "description": "List of ContactInfo reference IDs.",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "Gender": {
          "type": "string",
          "enum": [
            "Female",
            "Male",
            "Unspecified"
          ],
          "description": "Gender (if duplicated with Individual, apply precedence rules)."
        },
        "ResidenceCountryCode": {
          "type": "string",
          "description": "Country of residence (ISO)."
        },
        "CitizenshipCountryCode": {
          "type": "string",
          "description": "Country of citizenship (ISO)."
        },
        "PaxRefID": {
          "type": "string",
          "description": "Passenger reference ID (used for cross-structure linking)."
        },
        "IdentityDoc": {
          "type": "array",
          "description": "Travel documents such as ID/Passport.",
          "items": {
            "type": "object",
            "required": [
              "IdentityDocumentNumber",
              "IdentityDocumentType"
            ],
            "properties": {
              "IdentityDocumentNumber": {
                "type": "string",
                "description": "Document number (e.g., passport number)."
              },
              "IdentityDocumentType": {
                "type": "string",
                "description": "Document type. Example: PASSPORT"
              },
              "IssuingCountryCode": {
                "type": "string",
                "description": "Issuing country code."
              },
              "CitizenshipCountryCode": {
                "type": "string",
                "description": "Citizenship country code."
              },
              "ResidenceCountryCode": {
                "type": "string",
                "description": "Country of residence code."
              },
              "IssueDate": {
                "type": "string",
                "description": "Issue date."
              },
              "ExpiryDate": {
                "type": "string",
                "description": "Expiry date."
              },
              "Birthdate": {
                "type": "string",
                "description": "Birthdate as shown on the document."
              },
              "Birthplace": {
                "type": "string",
                "description": "Birthplace as shown on the document."
              },
              "Gender": {
                "type": "string",
                "enum": [
                  "Female",
                  "Male",
                  "Unspecified"
                ],
                "description": "Gender as shown on the document."
              },
              "NameTitle": {
                "type": "string",
                "description": "Title."
              },
              "GivenName": {
                "type": "array",
                "description": "Given names (multiple).",
                "items": {
                  "type": "string"
                },
                "maxItems": 5,
                "minItems": 0
              },
              "MiddleName": {
                "type": "array",
                "description": "Middle names (multiple).",
                "items": {
                  "type": "string"
                },
                "maxItems": 3,
                "minItems": 0
              },
              "Surname": {
                "type": "string",
                "description": "Surname."
              },
              "SurnameSuffix": {
                "type": "string",
                "description": "Surname suffix."
              },
              "Visa": {
                "type": "array",
                "description": "Visa information.",
                "items": {
                  "type": "object",
                  "properties": {
                    "VisaNumber": {
                      "type": "string",
                      "description": "Visa number."
                    },
                    "VisaType": {
                      "type": "string",
                      "description": "Visa type/code."
                    },
                    "VisaHostCountryCode": {
                      "type": "string",
