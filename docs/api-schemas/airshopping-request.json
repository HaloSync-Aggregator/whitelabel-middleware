{
  "api": "AirShopping",
  "root_schema": "AirShoppingRQ13",
  "total_schemas": 6,
  "schemas": {
    "AirShoppingRQ13": {
      "$id": "https://example.com/AirShoppingRQ",
      "title": "AirShoppingRQ",
      "type": "object",
      "required": [
        "Sender",
        "PointOfSale",
        "Query",
        "TransactionID"
      ],
      "properties": {
        "Sender": {
          "type": "object",
          "properties": {
            "TravelAgency": {
              "description": "Travel agency information",
              "$ref": "#/components/schemas/TravelAgencyType1"
            }
          },
          "required": [
            "TravelAgency"
          ]
        },
        "PointOfSale": {
          "type": "string",
          "description": "Point of sale e.g., KR"
        },
        "TransactionID": {
          "type": "string",
          "description": "Unique identifier key UUID\nTransaction ID\ne.g., 4ba5a0b50d2c45b3b5eb343b57ba8897\n\n32-character random number required.\n\nKey value for internal log tracking"
        },
        "Query": {
          "type": "object",
          "properties": {
            "OriginDestList": {
              "type": "array",
              "description": "Origin and destination list",
              "items": {
                "$ref": "#/components/schemas/OriginDestRequestType2"
              }
            },
            "PaxList": {
              "type": "array",
              "description": "Passenger list",
              "items": {
                "$ref": "#/components/schemas/PaxCodeType3"
              }
            },
            "Cabin": {
              "type": "string",
              "description": "Cabin class\nex) Y : economy\nex) W : premium economy\nex) C : business\nex) F : first\n\nIATA PADIS Codeset\n9873 Cabin class of service, coded\n\n1 : First class, Highest class of service (First Class Category)\n2 : Second class, Medium class of service (Business Class Category)\n3 : Third class, lowest class of service (all economy/coach class categories)\n4 : Economy/coach premium\n5 : Economy/coach\n6 : Economy/coach discounted\n7 : All"
            },
            "Criteria": {
              "$ref": "#/components/schemas/CriteriaType4"
            },
            "ResponseParameter": {
              "$ref": "#/components/schemas/ResponseParameterType5"
            }
          },
          "required": [
            "OriginDestList",
            "PaxList"
          ]
        }
      }
    },
    "TravelAgencyType1": {
      "type": "object",
      "properties": {
        "AgencyID": {
          "type": "string",
          "description": "Unique identifier for the travel agency (e.g., YOUR_TENANT_ID)"
        },
        "SiteCode": {
          "type": "string",
          "description": "Site code (e.g., 01, 51 ...)"
        },
        "AgencyName": {
          "type": "string",
          "description": "Name of the travel agency"
        },
        "ContactInfoRefID": {
          "type": "array",
          "description": "Reference ID for travel agency contact information. For certain airlines (e.g., BA, AF, KL), providing specific contact details is mandatory for OrderCreateRQ and OrderChangeRQ messages. Failure to provide this information will result in an error. \n• OrderCreateRQ Requirements:\n  - British Airways (BA): Agency email, postal address\n  - Air France (AF), KLM (KL): Agency email, phone number\n• OrderChangeRQ Requirements:\n  - British Airways (BA): Agency email, postal address",
          "items": {
            "type": "string",
            "description": "An individual reference ID for contact information. This ID links to detailed contact information that may be mandatory for specific airline NDC requests. For example, when creating or changing an order: \n\n•   OrderCreateRQ:\n    -   British Airways (BA): Requires agency email and postal address.\n    -   Air France (AF), KLM (KL): Requires agency email and phone number.\n•   OrderChangeRQ:\n    -   British Airways (BA): Requires agency email and postal address.\n\nFailure to provide required contact details for these airlines will result in a processing error."
          },
          "minItems": 0
        }
      },
      "title": "TravelAgencyType",
      "description": "Information pertaining to the Travel Agency in the context of NDC transactions.",
      "$id": "https://example.com/schemas/TravelAgencyType",
      "required": [
        "AgencyID"
      ]
    },
    "CriteriaType4": {
      "$id": "https://example.com/schemas/CriteriaType",
      "title": "CriteriaType",
      "type": "object",
      "description": "Search and filter criteria",
      "properties": {
        "Direct": {
          "type": "boolean",
          "description": "Whether to search for direct flights only (true = direct flights only)"
        },
        "AirlinePreference": {
          "type": "object",
          "description": "Preferred airline information",
          "properties": {
            "AirlineID": {
              "type": "array",
              "description": "List of preferred airline codes",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ProgramCriteria": {
          "type": "array",
          "description": "Criteria for applying specific programs",
          "items": {
            "type": "object",
            "properties": {
              "ContractID": {
                "type": "string",
                "description": "Contract ID"
              },
              "AccountID": {
                "type": "array",
                "description": "List of account IDs",
                "items": {
                  "type": "string"
                }
              },
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              },
              "TypeCode": {
                "type": "string",
                "description": "Type code"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "PromotionCriteria": {
          "type": "array",
          "description": "Criteria for applying promotions",
          "items": {
            "type": "object",
            "properties": {
              "PromotionID": {
                "type": "string",
                "description": "Promotion ID"
              },
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "SpecialFareCriteria": {
          "type": "array",
          "description": "Criteria for applying special fares",
          "items": {
            "type": "object",
            "properties": {
              "AirlineID": {
                "type": "string",
                "description": "Airline code"
              },
              "AccountID": {
                "type": "string",
                "description": "Account ID"
              }
            },
            "required": [
              "AirlineID"
            ]
          }
        },
        "ExistingOrderCriteria": {
          "type": "object",
          "description": "Criteria for referencing an existing order",
          "properties": {
            "OrderID": {
              "type": "string",
              "description": "Order ID"
            },
            "PaxRefID": {
              "type": "array",
              "description": "List of passenger reference IDs",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "OrderID",
            "PaxRefID"
          ]
        }
      }
    },
    "OriginDestRequestType2": {
      "$id": "https://example.com/schemas/OriginDestType",
      "title": "OriginDestType",
      "type": "object",
      "description": "Definition of a single Origin–Destination (OD) segment.",
      "properties": {
        "OriginCode": {
          "type": "string",
          "description": "Departure airport code (IATA 3-letter code). Example: ICN, BKK, LHR"
        },
        "DestCode": {
          "type": "string",
          "description": "Arrival airport code (IATA 3-letter code). Example: ICN, BKK, LHR"
        },
        "DepartureDate": {
          "type": "string",
          "description": "Planned departure date (ISO 8601 format, YYYY-MM-DD). Example: 2023-12-13"
        }
      },
      "required": [
        "OriginCode",
        "DestCode",
        "DepartureDate"
      ]
    },
    "PaxCodeType3": {
      "$id": "https://example.com/schemas/PaxCodeType",
      "title": "PaxCodeType",
      "type": "object",
      "description": "Definition of a single passenger",
      "properties": {
        "Ptc": {
          "type": "string",
          "description": "Passenger type (Adult, Child, Infant). Example: ADT, CHD, INF"
        },
        "PaxID": {
          "type": "string",
          "description": "Unique passenger identifier (e.g., T1, PAX1 …)"
        },
        "BirthDate": {
          "type": "string",
          "description": "Passenger date of birth (ISO8601 Date Format). Example: 2000-11-19"
        },
        "PaxRefID": {
          "type": "string",
          "description": "Reference unique passenger identifier (e.g., T1, PAX1 …)"
        },
        "LoyaltyProgramAccount": {
          "type": "array",
          "description": "Loyalty program list",
          "minItems": 0,
          "items": {
            "type": "object",
            "title": "LoyaltyProgramAccountType",
            "description": "Single loyalty program entry",
            "properties": {
              "AccountNumber": {
                "type": "string",
                "description": "Loyalty program account number (e.g., 1070199873)"
              },
              "ProgramCode": {
                "type": "string",
                "description": "Loyalty program code (e.g., FB)"
              },
              "ProgramName": {
                "type": "string",
                "description": "Loyalty program name (e.g., Miles)"
              },
              "SignInID": {
                "type": "string",
                "description": "Loyalty program sign-in ID (or username)"
              },
              "TierCode": {
                "type": "string",
                "description": "Loyalty program tier code"
              },
              "TierName": {
                "type": "string",
                "description": "Loyalty program tier name"
              }
            }
          }
        }
      },
      "required": [
        "Ptc",
        "PaxID"
      ]
    },
    "ResponseParameterType5": {
      "$id": "https://example.com/schemas/ResponseParameterType",
      "title": "ResponseParameterType",
      "type": "object",
      "properties": {
        "CurrencyCode": {
          "type": "string",
          "description": "Currency code (3-letter ISO 4217). Example: KRW, EUR, USD"
        },
        "LanguageUsage": {
          "type": "object",
          "properties": {
            "LangCode": {
              "type": "string",
              "description": "Language code. Example: en, en-US"
            },
            "LangUsageType": {
              "type": "string",
              "description": "Type of language usage (e.g., written, spoken)"
            }
          },
          "required": [
            "LangCode"
          ]
        }
      },
      "required": [
        "CurrencyCode"
      ]
    }
  }
}