        "class-validator": "^0.14.0",
        "js-yaml": "^4.1.1",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.0",
        "@types/node": "^25.0.6",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.9.3"
